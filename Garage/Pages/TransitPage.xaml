<Page x:Class="Garage.Pages.TransitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Garage.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TransitPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DGTransit" AutoGenerateColumns="False" IsReadOnly="True" SelectedCellsChanged="DGTransit_SelectedCellsChanged" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding IdTransit}" Width="*"/>
                <DataGridTextColumn Header="Автомобиль" Binding="{Binding Car.CarBrand}" Width="*"/>
                <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.Lastname}" Width="*"/>
                <DataGridTextColumn Header="Топливо" Binding="{Binding Fuel.FuelType}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusTransit.Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAddTransit" Click="BtnAddTransit_Click"  Content="Добавить перевозку" Style="{StaticResource BtnThreeType}"/>
            <Button x:Name="BtnUpdateTransit" Click="BtnUpdateTransit_Click"  Content="Редактировать перевозку" Style="{StaticResource BtnThreeType}"/>
        </StackPanel>
    </Grid>
</Page>
