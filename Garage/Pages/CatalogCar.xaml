<Page x:Class="Garage.Pages.CatalogCar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Garage.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CatalogCar">

    <Grid>
        <DataGrid x:Name="DGCar" AutoGenerateColumns="False" IsReadOnly="True" SelectedCellsChanged="DGCar_SelectedCellsChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding IdCar}" Width="*"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding CarBrand}" Width="*"/>
                <DataGridTextColumn Header="Гос. номер" Binding="{Binding LisensePlate}" Width="*"/>
                <DataGridTextColumn Header="Рекомендуемое топливо" Binding="{Binding Fuel.FuelType}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusCar.StatusName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
