<Page x:Class="Garage.Pages.CatalogDriver"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Garage.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CatalogDriver">

    <Grid>
        <DataGrid x:Name="DGDriver" AutoGenerateColumns="False" IsReadOnly="True" SelectedCellsChanged="DGDriver_SelectedCellsChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding IdDriver}" Width="*"/>
                <DataGridTextColumn Header="Автомобиль" Binding="{Binding Car.CarBrand}" Width="*"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Firstname}" Width="*"/>
                <DataGridTextColumn Header="Отчетсво" Binding="{Binding Middlename}" Width="*"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding Lastname}" Width="*"/>
                <DataGridTextColumn Header="Номер водительского удостоверения" Binding="{Binding DrivingLicenseNumber}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDriver.StatusName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
