<Page x:Class="Garage.Pages.CatalogFuel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Garage.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CatalogFuel">

    <Grid>
        <DataGrid x:Name="DGFuel" AutoGenerateColumns="False" IsReadOnly="True" SelectedCellsChanged="DGFuel_SelectedCellsChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding IdFuel}" Width="*"/>
                <DataGridTextColumn Header="Тип/название" Binding="{Binding FuelType}" Width="*"/>
                <DataGridTextColumn Header="Цена за литр" Binding="{Binding PricePerLiter}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
