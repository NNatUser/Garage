<Page x:Class="Garage.Pages.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Garage.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Catalog">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnOpenCatalogCar" Click="BtnOpenCatalogCar_Click" Style="{StaticResource BtnOneType}" Content="Автомобили"/>
            <Button x:Name="BtnOpenCatalogDriver" Click="BtnOpenCatalogDriver_Click"  Style="{StaticResource BtnOneType}" Content="Водители"/>
            <Button x:Name="BtnOpenCatalogFuel" Click="BtnOpenCatalogFuel_Click"  Style="{StaticResource BtnOneType}" Content="Топливо"/>
        </StackPanel>
        <Frame x:Name="FrameCatalog" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
