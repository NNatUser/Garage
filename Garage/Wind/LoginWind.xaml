<Window x:Class="Garage.Wind.LoginWind"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Garage.Wind"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Авторизация" Height="250" Width="350" ResizeMode="NoResize">
    <Grid>
        <StackPanel Margin="30" VerticalAlignment="Center">
            <TextBlock Text="Введите логин:" Style="{StaticResource TextBlock}"/>
            <TextBox x:Name="TBLogin"/>
            <TextBlock Text="Введите пароль:" Margin="0 10 0 0" Style="{StaticResource TextBlock}"/>
            <PasswordBox x:Name="PBPassword"/>
            <Button x:Name="BtnLogin" Click="BtnLogin_Click" Margin="0 20 0 0" Style="{StaticResource BtnOneType}" Content="Войти"/>
        </StackPanel>
    </Grid>
</Window>
