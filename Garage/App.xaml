<Application x:Class="Garage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Garage"
             StartupUri="Wind/LoginWind.xaml">
    <Application.Resources>
        <Style x:Key="TextBlock">
            <Setter Property="ItemsControl.FontSize" Value="18"/>
            <Setter Property="ItemsControl.FontFamily" Value="Tahoma"/>
        </Style>
        <Style x:Key="BtnOneType">
            <Setter Property="ItemsControl.Background" Value="#00AC6B"/>
            <Setter Property="ItemsControl.Height" Value="30"/>
            <Setter Property="ItemsControl.Width" Value="150"/>
            <Setter Property="ItemsControl.FontSize" Value="18"/>
        </Style>
        <Style x:Key="BtnTwoType">
            <Setter Property="ItemsControl.Background" Value="#FF6700"/>
            <Setter Property="ItemsControl.Foreground" Value="white"/>
            <Setter Property="ItemsControl.FontSize" Value="18"/>
            <Setter Property="ItemsControl.Width" Value="150"/>
            <Setter Property="ItemsControl.Padding" Value="10 2 10 2"/>
        </Style>
        <Style x:Key="BtnThreeType">
            <Setter Property="ItemsControl.Background" Value="#00AC6B"/>
            <Setter Property="ItemsControl.Height" Value="30"/>
            <Setter Property="ItemsControl.Padding" Value="10 2 10 2"/>
            <Setter Property="ItemsControl.Margin" Value="2"/>
        </Style>
    </Application.Resources>
</Application>
